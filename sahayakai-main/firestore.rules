rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // --- Access gate (docs/ACCESS_GATE_DESIGN.md) ---
    // The middleware gates every /api/* call, but the client SDK talks to
    // Firestore directly. Without the check below, an account that is signed
    // in but NOT approved (pending / blocked / expired pilot) could still read
    // shared product data straight from the database.
    //
    // Kill switch: the claim check only applies while the Admin-SDK-only doc
    // system_config/access_gate has `enforce == true`. Missing doc or
    // enforce != true means "any signed-in user", i.e. the pre-gate behaviour,
    // so deploying these rules changes nothing until the doc is flipped
    // (after the claim backfill; see docs/ACCESS_GATE_RUNBOOK.md).
    function accessGateEnforced() {
      return exists(/databases/$(database)/documents/system_config/access_gate)
        && get(/databases/$(database)/documents/system_config/access_gate).data.enforce == true;
    }

    // Mirrors evaluateAccess() in src/lib/access/access-state.ts:
    //   - entitled states are legacy / pilot / active;
    //   - a missing `access` claim is NOT entitled (fail closed);
    //   - a pilot MUST carry `accessExp`;
    //   - when `accessExp` (epoch seconds) is present it must be in the future.
    function hasEntitledClaim() {
      return ('access' in request.auth.token)
        && request.auth.token.access in ['legacy', 'pilot', 'active']
        && (request.auth.token.access != 'pilot' || ('accessExp' in request.auth.token))
        && (!('accessExp' in request.auth.token)
            || request.auth.token.accessExp > request.time.toMillis() / 1000);
    }

    // Signed in AND allowed to use the product. Use this (not isSignedIn())
    // for any rule that exposes shared / community / product data.
    function hasAccess() {
      return isSignedIn() && (!accessGateEnforced() || hasEntitledClaim());
    }

    // Check if caller is an admin of the given org
    function isOrgAdmin(orgId) {
      return isSignedIn()
        && get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.role == 'admin';
    }

    // Check if caller is a member of the given group (via members subcollection)
    function isGroupMember(groupId) {
      // hasAccess(): a member whose access was withdrawn or whose pilot
      // expired loses group reads together with the rest of the product.
      return hasAccess()
        && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
    }

    // Fields on the users/{uid} doc that a user must NEVER be able to set or
    // change via a direct client-SDK write. Privilege (role/admin/claims),
    // billing/plan, org/tenant membership, server-computed aggregates, and
    // immutable identity all live here. These are written only by Admin-SDK
    // server code (server actions, webhooks, cron), which bypasses rules.
    // Blocking them at the rule layer closes the direct-write bypass that the
    // server-action allowlist alone did not cover.
    function protectedUserFields() {
      return [
        // privilege / admin
        'role', 'isAdmin', 'adminRoles', 'superadmin', 'customClaims',
        // billing / plan
        'plan', 'planType', 'planTier', 'planExpiresAt', 'subscriptionStatus',
        'subscription', 'subscriptionId', 'razorpaySubscriptionId', 'razorpayCustomerId',
        'monthlyCredits', 'credits', 'creditsUsed', 'adminOverride', 'billing',
        // org / tenant membership (self-asserted role was a cross-tenant hole)
        'organizationId', 'organizationRole', 'administrativeRole',
        // server-computed aggregates
        'impactScore', 'badges', 'verifiedStatus', 'followersCount',
        'followingCount', 'contentSharedCount',
        // server-issued / immutable identity
        'referralCode', 'email', 'emailVerified', 'uid', 'createdAt',
        // push tokens (written only by the dedicated FCM action)
        'fcmTokens',
        // access gate — source of truth for the `access` custom claim; a
        // client that could write these could approve itself
        'accessState', 'accessExpiresAt', 'accessUpdatedAt', 'accessUpdatedBy',
        'planSource'
      ];
    }

    // A self-update is allowed only if it touches none of the protected fields.
    function isSafeUserUpdate() {
      return !request.resource.data.diff(resource.data)
                .affectedKeys().hasAny(protectedUserFields());
    }

    // =============================================
    // EXISTING COLLECTIONS
    // =============================================

    // --- Feedback (signed-in users only) ---
    match /feedbacks/{document} {
      allow create: if isSignedIn();
    }

    // --- Users ---
    // Each user can only read/write their own document
    match /users/{userId} {
      allow read: if isOwner(userId);
      // Owner may update their own doc but NEVER privileged/billing/org/identity
      // fields — those are Admin-SDK-only (see protectedUserFields()).
      allow update: if isOwner(userId) && isSafeUserUpdate();
      // On create, forbid a user seeding themselves with privileged values.
      allow create: if isOwner(userId)
                    && !request.resource.data.keys().hasAny(protectedUserFields());

      // --- Blocks (moderation v1) ---
      // A user's block list is private to them: owner-only read/write.
      // Enforcement (DM rejection, feed filtering) happens server-side via
      // the Admin SDK — these rules only guarantee nobody else can read or
      // tamper with the list (a blocked user must never learn they were
      // blocked).
      match /blocks/{blockedUid} {
        allow read, write: if isOwner(userId);
      }
    }

    // --- Content ---
    // User-generated content (lesson plans, quizzes, etc.) stored in top-level collection
    match /content/{documentId} {
      allow read, update, delete: if request.auth.uid == resource.data.userId;
      allow create: if request.auth.uid == request.resource.data.userId;
    }

    // --- Community Library ---
    // Public read; writes only via trusted backend (Server SDK / Admin SDK)
    match /community/{communityContentId} {
      // Was world-readable; nothing in the app reads it from the client.
      allow read: if hasAccess();
      allow write: if false;
    }

    // --- Notifications ---
    // Recipients can read their own notification docs (powers the global
    // sidebar badge + the /notifications page realtime updates).
    // Writes/updates are owned by the server (Admin SDK via server actions
    // in src/app/actions/notifications.ts) — the client cannot fabricate
    // notifications nor mark them as read directly. Updates from the
    // recipient go through markNotificationAsReadAction.
    match /notifications/{notifId} {
      allow read: if isSignedIn() && resource.data.recipientId == request.auth.uid;
      allow create, update, delete: if false;
    }

    // --- Direct Messages & Group Conversations ---

    // Access gate: messaging is a product surface, so every rule here needs
    // hasAccess() on top of the participant check.
    match /conversations/{convId} {
      allow read: if hasAccess()
        && request.auth.uid in resource.data.participantIds;

      // Server-only (POST /api/messages/*). A client write could set
      // type:'group' on a direct chat (skipping the block check), add outsiders
      // to participantIds (who then read the history), rename another member,
      // or plant a conversation in someone's inbox. No client writes here.
      allow create, update, delete: if false;

      match /messages/{msgId} {
        allow read: if hasAccess()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participantIds;

        // Server-only (POST /api/messages/send): the route checks blocks, rate
        // limits and sets senderName from the profile. A direct client create
        // could post under any display name and skip those checks.
        allow create: if false;

        // A participant may only stamp read/delivery receipts — NOT edit the
        // message text, sender, or attachments (previously any participant
        // could overwrite ANY message's content, enabling impersonation).
        // Message content is authored on create and never client-mutable after.
        allow update: if hasAccess()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participantIds
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['readBy', 'deliveredTo', 'readAt', 'deliveredAt', 'lastReadAt']);

        allow delete: if false;
      }
    }

    // --- Community Chat (broadcast — all entitled users) ---
    // Access gate: hasAccess(), not isSignedIn().
    match /community_chat/{messageId} {
      allow read: if hasAccess();
      // Server-only (POST /api/community/chat): a client create could set any
      // authorName/authorPhotoURL (impersonation) and an unbounded text.
      allow create, update, delete: if false;
    }

    // --- Connection Requests ---
    match /connection_requests/{reqId} {
      // Access gate: only entitled accounts may reach out to teachers. Read /
      // delete of the caller's OWN requests stay on isSignedIn().
      allow create: if hasAccess()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.fromUid != request.resource.data.toUid;

      allow read: if isSignedIn()
        && (request.auth.uid == resource.data.fromUid
            || request.auth.uid == resource.data.toUid);

      allow delete: if isSignedIn()
        && (request.auth.uid == resource.data.fromUid
            || request.auth.uid == resource.data.toUid);

      allow update: if false;
    }

    // --- Reports (moderation v1) ---
    // Create-only for authenticated users; the reporter identity must match
    // the caller and the doc must land in 'open' state with a known reason.
    // NO client read path — admins review reports via the Admin SDK only
    // (reports contain reporter identity + free text about other users).
    // The primary write path is POST /api/moderation/report (Admin SDK,
    // rate-limited); this rule keeps a direct client create equally strict.
    match /reports/{reportId} {
      // Access gate: a non-entitled account can see no reportable content.
      allow create: if hasAccess()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.targetType in ['message', 'post', 'profile', 'resource']
        && request.resource.data.reason in ['harassment', 'inappropriate', 'spam', 'other']
        && request.resource.data.targetId is string
        && request.resource.data.targetId.size() <= 256
        && (!('freeText' in request.resource.data)
            || (request.resource.data.freeText is string
                && request.resource.data.freeText.size() <= 500));
      allow read, update, delete: if false;
    }

    // --- Connections (accepted, symmetric) ---
    match /connections/{connId} {
      // Only the two connected users may read a connection — previously any
      // signed-in user could read every doc and enumerate the whole social graph.
      allow read: if isSignedIn() && request.auth.uid in resource.data.uids;
      allow create: if false;
      allow delete: if isSignedIn()
        && request.auth.uid in resource.data.uids;
      allow update: if false;
    }

    // =============================================
    // COMMUNITY: GROUPS, POSTS, LIBRARY
    // =============================================
    // All writes flow through server actions (Admin SDK, bypassing these rules).
    // Client reads are gated to authenticated members of the relevant group.

    // --- Groups (metadata) ---
    // Anyone signed in can read group metadata (name, description, member count) —
    // needed for the Discover Groups surface. Only members can read posts/chat
    // inside the group (see nested matches below). All writes go through server.
    match /groups/{groupId} {
      allow read: if hasAccess();  // access gate (was: any signed-in user)
      allow write: if false;

      // --- Group Posts ---
      // Read: members only. Write: server-only (createGroupPostAction uses Admin SDK).
      match /posts/{postId} {
        allow read: if isGroupMember(groupId);
        allow write: if false;

        // Likes subcollection: owner-only read/write
        match /likes/{likerId} {
          allow read, write: if isOwner(likerId) && isGroupMember(groupId);
        }
      }

      // --- Group Members ---
      // Read: any member can see the membership list. Write: server-only
      // (joinGroupAction / leaveGroupAction use Admin SDK).
      match /members/{memberId} {
        allow read: if isGroupMember(groupId);
        allow write: if false;
      }

      // --- Group Chat (real-time messages) ---
      // Read + create: members only. Update/delete: server-only.
      match /chat/{messageId} {
        allow read: if isGroupMember(groupId);
        // Server-only (group chat API checks membership and sets author fields).
        allow create, update, delete: if false;
      }
    }

    // --- Public Community Posts (top-level `posts` collection) ---
    // The community feed reads here. Authenticated users can read; writes flow
    // through createPostAction (Admin SDK).
    match /posts/{postId} {
      allow read: if hasAccess();  // access gate (was: any signed-in user)
      allow write: if false;

      match /likes/{likerId} {
        allow read, write: if hasAccess() && isOwner(likerId);
      }
    }

    // --- Community Library Resources ---
    // Public for signed-in users (community discovery). Writes via
    // publishContentToLibraryAction / scheduled jobs (Admin SDK).
    match /library_resources/{resourceId} {
      allow read: if hasAccess();  // access gate (was: any signed-in user)
      allow write: if false;

      // Likes / Saves subcollections — owner-only, entitled accounts only
      match /likes/{likerId} {
        allow read, write: if hasAccess() && isOwner(likerId);
      }
      match /saves/{saverId} {
        allow read, write: if hasAccess() && isOwner(saverId);
      }
    }

    // =============================================
    // BILLING & ORGANIZATION COLLECTIONS
    // =============================================

    // --- Credit Ledger ---
    // Stores balance, plan, cycle dates per user.
    // Read: owner only. Write: Admin SDK only (server-side billing logic).
    match /credit_ledger/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // --- Organizations ---
    // School/chain info, Razorpay IDs, seat counts.
    // Read: org admins only (via get() on members subcollection).
    // Write: Admin SDK only.
    match /organizations/{orgId} {
      allow read: if isOrgAdmin(orgId);
      allow write: if false;

      // --- Organization Members ---
      // Read: org admins can list all members; teachers can read their own doc.
      // Write: Admin SDK only (invite/remove handled server-side).
      match /members/{memberId} {
        allow read: if isOwner(memberId) || isOrgAdmin(orgId);
        allow write: if false;
      }

      // --- Organization Join Links (access gate) ---
      // Only a sha256 of the join code is stored, but uses / expiry / seat
      // caps are still operator state. Created, redeemed and revoked through
      // /api/organizations/** (Admin SDK) only.
      match /joinLinks/{linkId} {
        allow read, write: if false;
      }
    }

    // --- Webhook Events ---
    // Razorpay idempotency tracking. Completely backend-only.
    match /webhook_events/{eventId} {
      allow read, write: if false;
    }

    // --- Payments Ledger (H21) ---
    // payments_ledger/{paymentId}: paymentId-keyed idempotency + amount-
    // binding audit ledger. Created TRANSACTIONALLY with each plan grant
    // (Razorpay webhook + org-creation paths) via the Admin SDK only.
    // If a client could create/delete these docs it could pre-block or
    // unblock payment ids — deny everything.
    match /payments_ledger/{paymentId} {
      allow read, write: if false;
    }

    // --- Per-user daily usage counters ---
    // daily_user_usage/{uid_date}: cost-cap + daily feature-quota counters
    // (usage-tracker.ts). Written server-side only; a client that could
    // write these could zero out its own quota.
    match /daily_user_usage/{docId} {
      allow read, write: if false;
    }

    // --- Config: Plans ---
    // Feature limits per plan. Readable by any authenticated user.
    // Written only via Admin SDK or Firebase console.
    match /config/plans {
      allow read: if hasAccess();  // access gate (was: any signed-in user)
      allow write: if false;
    }

    // --- Usage Counters ---
    // Per-user monthly/daily usage counters for subscription gating.
    // Read: owner only. Write: Admin SDK only (incremented server-side).
    match /usageCounters/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // --- Subscriptions ---
    // Razorpay subscription tracking. Read: owner only. Write: Admin SDK only.
    match /subscriptions/{subId} {
      allow read: if isSignedIn()
        && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // --- System Config ---
    // Round-2 audit P0 SYSCONF-1 fix (30-agent review, group D5):
    // operator state (rollout flags, kill-switch, sidecar mode) MUST
    // NOT be readable by every signed-in teacher — leaks the rollout
    // strategy, model toggles, and percent-bucket state to clients.
    //
    // Split: doc IDs starting with `public_` are client-readable
    // (e.g. `public_maintenance_banner` for the user-visible banner);
    // everything else (including `feature_flags`) is Admin-SDK-only.
    //
    // `system_config/access_gate` (the rules kill switch read by
    // accessGateEnforced() above) is deliberately NOT `public_`: rules-side
    // get()/exists() bypass these read rules, so no client ever needs it.
    match /system_config/{docId} {
      allow read: if isSignedIn() && docId.matches('^public_.*');
      allow write: if false;
    }

    // =============================================
    // SAHAYAKAI AGENTS — PARENT-CALL SIDECAR
    // =============================================
    // Round-2 audit P0 RULES-1: every collection the sidecar writes to
    // is Admin-SDK-only. Clients NEVER read or write these — the call
    // SID would let an attacker harvest full transcripts. Mirrors the
    // existing `webhook_events` shape.

    // Per-call session metadata + turn subcollection.
    // Composite key `{turn_number:04d}_{role}` is the doc id under turns/.
    // TTL applied via `agent_sessions/{callSid}.expireAt` field
    // (24h after the call ends; see scripts/apply-firestore-ttl.sh).
    match /agent_sessions/{callSid} {
      allow read, write: if false;
      match /turns/{turnId} {
        allow read, write: if false;
      }
    }

    // Shadow-mode parity capture: { genkit_reply, sidecar_reply, ... }
    // Written by the Next.js dispatcher fire-and-forget; read by the
    // shadow-diff aggregator Cloud Function for the rolling LaBSE mean.
    // TTL via `agent_shadow_diffs/{date}/shadow_calls/{id}.expireAt` (14d).
    //
    // Round-2 audit P0 TTL-2 fix (30-agent review, group D5):
    // subcollection renamed from `calls` → `shadow_calls`. Firestore
    // TTL is collection-group scoped; with the generic `calls` name,
    // any future top-level or nested `calls` subcollection in the
    // project would silently inherit the 14-day TTL. `shadow_calls`
    // is unique and reserves the name.
    match /agent_shadow_diffs/{dateDoc} {
      allow read, write: if false;
      match /shadow_calls/{callId} {
        allow read, write: if false;
      }
    }

    // Phase 2 placeholder — voice session metadata (transcript, audio
    // duration, behavioural-guard events). Voice payloads are even
    // more sensitive than text transcripts; explicit deny here even
    // though the default is also deny.
    match /agent_voice_sessions/{callSid} {
      allow read, write: if false;
    }

    // Auto-abort dedupe sentinel: one doc per incident_id, written by
    // the auto-abort Cloud Function on first successful demote. TTL
    // via `expireAt` (24h). Same shape as agent_sessions — Admin SDK
    // only.
    match /agent_auto_abort_seen/{incidentId} {
      allow read, write: if false;
    }

    // Do-not-call list: call_suppressions/{id}, id = sha256(E.164|SAMPARK_PHONE_PEPPER)
    // (older entries: sha256(E.164); both are looked up). Written by the
    // telephony engine that hears a parent ask not to be called again
    // (sahayakai-agents `_persist_opt_out`); read by /api/attendance/call and
    // /api/attendance/outreach before any dial (src/lib/call-suppression.ts).
    // Admin SDK only: a client that could delete one would re-enable calls to
    // a parent who said no, and the records name the teacher, class and
    // student. Explicit, although the default is also deny.
    match /call_suppressions/{phoneHash} {
      allow read, write: if false;
    }

    // =============================================
    // PRESENCE + TYPING (migrated off RTDB → Firestore/Mumbai, 2026-07-04)
    // Ephemeral, non-personal session state. See use-presence.ts /
    // use-typing-indicator.ts and MUMBAI_REGION_MIGRATION_RUNBOOK.md §6.
    // TTL policies on `expireAt` (deploy separately) reap idle docs.
    // =============================================
    match /presence/{uid} {
      // Any entitled user may see who is online (contacts/conversations).
      // Access gate: hasAccess(), not isSignedIn().
      allow read: if hasAccess();
      // Only the owner writes their own presence. Deliberately NOT gated:
      // it is the caller's own doc, and gating it would add a config read to
      // every heartbeat and throw in the client for a pending account.
      allow write: if isOwner(uid);
    }

    match /typing_status/{conversationId} {
      // Participants only: the doc id is the DM id (sorted uid pair), so an
      // open read let anyone confirm that two users are messaging.
      allow read: if hasAccess()
        && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
      // A caller may only add/refresh their OWN uid key (plus the expireAt
      // housekeeping field) — never assert that someone else is typing.
      allow write: if hasAccess()
        && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds
        && request.resource.data.diff(
             resource == null ? {} : resource.data
           ).affectedKeys().hasOnly([request.auth.uid, 'expireAt']);
    }

    // =============================================
    // ACCESS GATE COLLECTIONS (docs/ACCESS_GATE_DESIGN.md)
    // =============================================
    // All Admin-SDK-only. A client that could write any of these could
    // approve itself, forge a school quote, erase the audit trail, or clear
    // an anomaly flag; a client that could read them would see other
    // schools' contact details. Explicit deny for auditability.

    // One access request per account, reviewed by a SahayakAI admin.
    match /access_requests/{uid} {
      allow read, write: if false;
    }

    // Public school quote form (POST /api/access/quote).
    match /quote_requests/{quoteId} {
      allow read, write: if false;
    }

    // Append-only record of every access-state change.
    match /access_audit/{auditId} {
      allow read, write: if false;
    }

    // Anomaly flags raised by the nightly access-expiry job.
    match /access_flags/{uid} {
      allow read, write: if false;
    }

    // =============================================
    // DEFAULT DENY
    // =============================================
    // Any collection not matched above is denied by default.
    // This explicit rule documents the intent — Firestore denies
    // unmatched paths anyway, but this makes audits clearer.
  }
}
