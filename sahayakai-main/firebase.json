{
    "hosting": {
        "source": ".",
        "ignore": [
            "firebase.json",
            "**/node_modules/**",
            ".git/**",
            ".github/**",
            ".claude/**",
            ".agent/**",
            ".gemini/**",
            ".genkit/**",
            ".idx/**",
            ".next/**",
            ".firebase/**",
            ".gitignore",
            ".dockerignore",
            ".gcloudignore",
            ".deployment-changelog.json",
            ".modified",
            "**/.env",
            "**/.env.*",
            "**/.npmrc",
            "**/.netrc",
            "**/.ssh/**",
            "**/.aws/**",
            "**/.gcloud/**",
            "**/.DS_Store"
        ],
        "frameworksBackend": {
            "region": "asia-southeast1"
        }
    },
    "functions": {
        "source": ".",
        "codebase": "default",
        "ignore": [
            "node_modules",
            ".git",
            "firebase-debug.log",
            "firebase-debug.*.log"
        ]
    },
    "firestore": {
        "rules": "firestore.rules",
        "indexes": "firestore.indexes.json"
    },
    "storage": [
        {
            "bucket": "sahayakai-b4248.firebasestorage.app",
            "rules": "storage.rules"
        },
        {
            "bucket": "sahayakai-b4248-mumbai",
            "rules": "storage.rules"
        }
    ]
}