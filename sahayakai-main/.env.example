# SahayakAI — environment configuration template
# Copy to `.env.local` for local dev. Production values live in Cloud Run
# env vars + Secret Manager. The variables below are READ AT PROCESS
# START — bumping a number means you must redeploy (or restart `next
# dev`) for the new value to take effect.

# ─── LLM dispatcher timeouts (NCERT demo hot-fix, 2026-05-19) ────────
# Each of the five at-risk LLM flows now reads its budget from an env
# var, falling back to a safe production default. Bump these BEFORE
# running a flaky demo — increase by 5-10s when you see "timed out
# after Xms" structured-log lines in Cloud Run.

# Rubric generator (default 30s). Observed p50 was 17.3s. Same knob
# governs the sidecar HTTP client TIMEOUT_MS (default 25s) — set this
# to the larger of the two budgets you want.
RUBRIC_TIMEOUT_MS=30000

# Teacher-training advice (default 25s). Observed p50 was 13.7s. Same
# knob governs the sidecar HTTP client TIMEOUT_MS (default 20s).
TEACHER_TRAINING_TIMEOUT_MS=25000

# Quiz generator — split because the sidecar HTTP call and the Genkit
# fallback have different cost profiles (3 parallel variants + multimodal).
# Observed p50 was 32.5s; p75 was failing at the old 45s budget.
QUIZ_CLIENT_TIMEOUT_MS=60000
QUIZ_FALLBACK_TIMEOUT_MS=60000

# Video storyteller — split because RSS + YouTube fetch + LLM categorisation
# tail differs between the two paths. Observed p50 was 12.6s; p75 was
# failing at the old 15s budget.
VIDEO_STORYTELLER_CLIENT_TIMEOUT_MS=30000
VIDEO_STORYTELLER_FALLBACK_TIMEOUT_MS=30000

# Instant answer (default 20s for both client + fallback). Observed p50
# was 8.3s. The client used to race the dispatcher fallback (10s vs 20s)
# — same env var now governs both knobs to keep them aligned.
INSTANT_ANSWER_CLIENT_TIMEOUT_MS=20000

# ─── Security header / attestation flips (Tranche 7, 2026-07-03) ────
# Content-Security-Policy enforcement. Report-Only ALWAYS ships (see
# src/middleware.ts). Setting this to `true` additionally sends the
# enforcing `Content-Security-Policy` header with the identical policy.
# Rollback = unset (config-only, no code redeploy).
# CSP_ENFORCED=true

# Firebase App Check enforcement at the Next.js middleware: when `true`,
# /api/ai/* requests without a valid X-Firebase-AppCheck header are 401'd.
# DO NOT flip blind — follow docs/compliance/APP_CHECK_ROLLOUT.md.
# The sidecars have their own flag (SAHAYAKAI_REQUIRE_APP_CHECK, set on
# the sidecar Cloud Run services, not here).
# APP_CHECK_REQUIRED=true

# reCAPTCHA v3 site key that powers browser-side App Check token minting
# (src/lib/firebase-app-check.ts). Unset = App Check disabled on client.
# NEXT_PUBLIC_RECAPTCHA_V3_SITE_KEY=

# ─── VIDYA voice (Gemini Live audio-to-audio) ────────────────────────
# Additive, feature-flagged real-time voice. When OFF (default) the
# OmniOrb stays on the turn-based STT → classifier → TTS pipeline.
# When "true", POST /api/vidya-voice/start-session returns the sidecar's
# Vertex Live WebSocket URL plus a short-lived HMAC stream token.
VIDYA_VOICE_LIVE_ENABLED=false
# Canary allowlist: comma-separated Firebase uids permitted to open a
# Live session. UNSET OR EMPTY DENIES EVERYONE — the flag above is
# already "true" in the deployed environment, so this list is what
# actually bounds who can open a billable Vertex socket. Start with the
# handful of teachers who agreed to pilot it; widen only after the
# sidecar's cost controls (PR #123) are merged and deployed.
VIDYA_VOICE_LIVE_ALLOWED_UIDS=
# ─── "Hear the Call" public demo (lead magnet) ───────────────────────
# Spec: docs/PARENT_CALL_DEMO_SPEC.md. Endpoint is anon + places real
# calls — keep the flag OFF unless the gates below are provisioned.
DEMO_CALL_ENABLED=false
# Hard global spend ceiling (calls/day, UTC window). Soft launch: 50.
DEMO_CALL_DAILY_CAP=500
DEMO_CALL_IP_DAILY_LIMIT=3
DEMO_CALL_PHONE_COOLDOWN_DAYS=30
# REQUIRED in prod: pepper for hashed phone/IP gate keys (any long random string).
DEMO_CALL_PEPPER=
# Optional: base64 32-byte key; without it leads store only last-4 digits.
DEMO_CALL_ENC_KEY=
# Optional Cloudflare Turnstile (bot gate). Server verifies only when the
# secret is set; the widget renders only when the site key is set.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
