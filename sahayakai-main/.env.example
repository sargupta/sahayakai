# ── Exotel Telephony Configuration (Sampark voice calls) ──────────────────
# Copy this to .env.local and fill in your real values. Never commit .env.local.
# Exotel dashboard: https://dashboard.exotel.com
EXOTEL_SID=your_exotel_account_sid
EXOTEL_API_KEY=your_exotel_api_key
EXOTEL_API_TOKEN=your_exotel_api_token
EXOTEL_SUBDOMAIN=api.exotel.com
EXOTEL_REGION=Singapore
EXOTEL_CALLER_ID=+91XXXXXXXXXX
EXOTEL_APP_ID=your_exotel_app_id

# ── Existing (keep for reference) ─────────────────────────────────────────
# TWILIO_ACCOUNT_SID=...
# TWILIO_AUTH_TOKEN=...
# TWILIO_PHONE_NUMBER=...
# VOICE_PROVIDER=twilio