# Copy to android/key.properties and fill in. That file is GITIGNORED —
# never commit it, and never commit the keystore it points at.
#
# Upload key (created 2026-11-14; replaces the old Capacitor upload.keystore,
# which was never used on Play for com.sargvision.sahayakai):
#   PKCS12 keystore, alias "upload", RSA 2048. Kept OUTSIDE the repo so a
#   git clean can never delete it. Back it up off-machine; losing it means a
#   Play upload-key reset.
#
# Upload certificate fingerprints:
#   SHA-1:   B2:E6:3C:83:CD:A2:D3:90:70:D9:26:F1:6C:35:15:CD:1D:E6:0C:55
#   SHA-256: 27:25:DE:7A:4D:3B:24:9B:BC:01:B7:09:4D:7A:4A:D4:3B:6A:5C:9B:AF:2E:BB:43:FE:EE:2F:BC:4A:60:D9:9B
# Verify any build against it with:  bash scripts/loop/verify_aab_signer.sh
#
# Without android/key.properties the release build falls back to DEBUG
# signing. Never upload such a build.

# Absolute path, or relative to android/app/ (where build.gradle.kts resolves file() from).
storeFile=C:/Users/<you>/sahayakai-signing/sahayakai-upload.jks
storePassword=
keyAlias=upload
# PKCS12: the key password is the keystore password.
keyPassword=
